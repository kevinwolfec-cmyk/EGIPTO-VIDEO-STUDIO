+#pragma once
+
+#include <QObject>
+#include <QByteArray>
+#include <QSet>
+#include <QMap>
+#include <QString>
+#include <QVariantList>
+
+class AppController;
+class AssetLibrary;
+class QNetworkAccessManager;
+class QNetworkReply;
+
+class FishAudioController : public QObject
+{
+    Q_OBJECT
+    Q_PROPERTY(QString apiKey READ apiKey WRITE setApiKey NOTIFY apiKeyChanged)
+    Q_PROPERTY(QString referenceId READ referenceId WRITE setReferenceId NOTIFY referenceIdChanged)
+    Q_PROPERTY(QString modelId READ modelId WRITE setModelId NOTIFY modelIdChanged)
+    Q_PROPERTY(double speed READ speed WRITE setSpeed NOTIFY speedChanged)
+    Q_PROPERTY(bool autoPlaceMedia READ autoPlaceMedia WRITE setAutoPlaceMedia NOTIFY autoPlaceMediaChanged)
+    Q_PROPERTY(bool busy READ busy NOTIFY busyChanged)
+    Q_PROPERTY(QString status READ status NOTIFY statusChanged)
+    Q_PROPERTY(QString errorString READ errorString NOTIFY errorStringChanged)
+    Q_PROPERTY(QVariantList voices READ voices NOTIFY voicesChanged)
+    Q_PROPERTY(QVariantList blocks READ blocks NOTIFY blocksChanged)
+    Q_PROPERTY(int nextMediaSlot READ nextMediaSlot NOTIFY nextMediaSlotChanged)
+
+public:
+    explicit FishAudioController(AssetLibrary *assets, AppController *editor, QObject *parent = nullptr);
+    ~FishAudioController() override;
+
+    QString apiKey() const { return m_apiKey; }
+    void setApiKey(const QString &value);
+    QString referenceId() const { return m_referenceId; }
+    void setReferenceId(const QString &value);
+    QString modelId() const { return m_modelId; }
+    void setModelId(const QString &value);
+    double speed() const { return m_speed; }
+    void setSpeed(double value);
+    bool autoPlaceMedia() const { return m_autoPlaceMedia; }
+    void setAutoPlaceMedia(bool value);
+
+    bool busy() const { return m_busy; }
+    QString status() const { return m_status; }
+    QString errorString() const { return m_errorString; }
+    QVariantList voices() const { return m_voices; }
+    QVariantList blocks() const { return m_blocks; }
+    int nextMediaSlot() const { return m_nextMediaSlot; }
+
+    Q_INVOKABLE void loadVoices();
+    Q_INVOKABLE void generateVoiceAndTimeline(const QString &script);
+    Q_INVOKABLE void placeWaitingMedia();
+    Q_INVOKABLE void clearError();
+
+signals:
+    void apiKeyChanged();
+    void referenceIdChanged();
+    void modelIdChanged();
+    void speedChanged();
+    void autoPlaceMediaChanged();
+    void busyChanged();
+    void statusChanged();
+    void errorStringChanged();
+    void voicesChanged();
+    void blocksChanged();
+    void nextMediaSlotChanged();
+    void generationFinished(const QString &audioPath, int blockCount);
+
+private:
+    struct Segment {
+        QString text;
+        double start = 0.0;
+        double end = 0.0;
+    };
+    struct Word {
+        QString raw;
+        QString norm;
+        int charStart = 0;
+        int charEnd = 0;
+        double start = -1.0;
+        double end = -1.0;
+    };
+    struct SceneBlock {
+        double start = 0.0;
+        double end = 0.0;
+        QString text;
+    };
+
+    void setBusy(bool value);
+    void setStatus(const QString &value);
+    void fail(const QString &message);
+    void saveSettings();
+
+    void startVoiceRequest(const QString &script);
+    void consumeSse();
+    void processSseLine(const QByteArray &line);
+    void finishVoiceRequest();
+    void resetNetworkState();
+
+    QList<SceneBlock> buildSceneBlocks(const QString &original, const QList<Segment> &segments) const;
+    static QString normalizeWord(const QString &value);
+    static QList<Word> tokenizeOriginal(const QString &text);
+    static QList<Word> timedWords(const QList<Segment> &segments);
+    static double alignWords(QList<Word> &original, const QList<Word> &timed);
+    static QList<QPair<int,int>> sentenceRanges(const QString &text, const QList<Word> &words);
