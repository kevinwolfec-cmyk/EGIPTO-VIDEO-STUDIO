+
+    const QString kind = asset.value(QStringLiteral("kind")).toString();
+    if (kind != QStringLiteral("image") && kind != QStringLiteral("video"))
+        return false;
+
+    const QVariantMap block = m_blocks[blockIndex].toMap();
+    const double start = block.value(QStringLiteral("start")).toDouble();
+    const double duration = block.value(QStringLiteral("duration")).toDouble();
+    if (!(duration > 0.0))
+        return false;
+
+    const int track = ensureNamedTrack(QStringLiteral("video"), QStringLiteral("Visual Fish"));
+    if (track < 0)
+        return false;
+
+    m_editor->addClipFromAssetAt(assetIndex, track, start);
+    if (m_editor->selectedTrack() != track || m_editor->selectedClip() < 0)
+        return false;
+
+    const int clip = m_editor->selectedClip();
+    m_editor->setClipStart(track, clip, start);
+    m_editor->setClipDuration(track, clip, duration);
+
+    m_placedVisualAssetIds.insert(assetId);
+    return true;
+}
+
+void FishAudioController::autoPlaceAvailableMedia()
+{
+    if (!m_autoPlaceMedia || m_blocks.isEmpty() || m_nextMediaSlot >= m_blocks.size())
+        return;
+
+    const QList<int> assets = visualAssetIndexesInNaturalOrder();
+    bool advanced = false;
+
+    for (const int assetIndex : assets) {
+        if (m_nextMediaSlot >= m_blocks.size())
+            break;
+
+        const QVariantMap asset = m_assets->assetAt(assetIndex);
+        const QString id = asset.value(QStringLiteral("id")).toString();
+        if (id.isEmpty() || m_placedVisualAssetIds.contains(id))
+            continue;
+        if (m_assets->isImportPending(id))
+            continue;
+
+        if (placeVisualAsset(assetIndex, m_nextMediaSlot)) {
+            ++m_nextMediaSlot;
+            advanced = true;
+            emit nextMediaSlotChanged();
+        }
+    }
+
+    if (m_nextMediaSlot >= m_blocks.size()) {
+        setStatus(tr("Timeline Fish completa: %1/%1 medios ajustados a timestamps.")
+                      .arg(m_blocks.size()));
+    } else if (advanced) {
+        setStatus(tr("Medios Fish: %1/%2 colocados. Los próximos imports se acoplarán automáticamente.")
+                      .arg(m_nextMediaSlot)
+                      .arg(m_blocks.size()));
+    }
+}
+
+void FishAudioController::placeWaitingMedia()
+{
+    autoPlaceAvailableMedia();
+}
