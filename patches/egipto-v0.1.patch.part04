+    static QString textForRange(const QString &text, const QList<Word> &words, int begin, int end);
+    static SceneBlock blockForRange(const QString &text, const QList<Word> &words, int begin, int end);
+    static QList<SceneBlock> splitRange(const QString &text, const QList<Word> &words, int begin, int end);
+    static QList<SceneBlock> mergeShort(const QList<SceneBlock> &blocks);
+    static QList<SceneBlock> applyPreroll(const QList<SceneBlock> &blocks, double prerollSeconds = 0.100);
+
+    int findTrack(const QString &type, const QString &name) const;
+    int ensureNamedTrack(const QString &type, const QString &name);
+    void importAndPlaceVoice(const QString &path, double durationSeconds);
+    void tryPlacePendingVoice();
+
+    void scheduleAutoPlacement();
+    void autoPlaceAvailableMedia();
+    bool placeVisualAsset(int assetIndex, int blockIndex);
+    QList<int> visualAssetIndexesInNaturalOrder() const;
+
+    AssetLibrary *m_assets = nullptr;
+    AppController *m_editor = nullptr;
+    QNetworkAccessManager *m_network = nullptr;
+    QNetworkReply *m_reply = nullptr;
+
+    QString m_apiKey;
+    QString m_referenceId;
+    QString m_modelId = QStringLiteral("s2-pro");
+    double m_speed = 1.0;
+    bool m_autoPlaceMedia = true;
+    bool m_busy = false;
+    QString m_status;
+    QString m_errorString;
+    QVariantList m_voices;
+    QVariantList m_blocks;
+
+    QString m_script;
+    QByteArray m_sseBuffer;
+    QByteArray m_audioBytes;
+    QList<Segment> m_segments;
+    QMap<int, QList<Segment>> m_segmentsByChunk;
+    QString m_outputAudioPath;
+
+    int m_nextMediaSlot = 0;
+    QSet<QString> m_placedVisualAssetIds;
+    QString m_pendingVoiceAssetId;
+    double m_pendingVoiceDuration = 0.0;
+    bool m_autoPlacementScheduled = false;
+};
