diff --git a/src/models/FishAudioController.cpp b/src/models/FishAudioController.cpp
new file mode 100644
index 0000000..d0997c4
--- /dev/null
+++ b/src/models/FishAudioController.cpp
@@ -0,0 +1,1049 @@
+#include "FishAudioController.h"
+
+#include "AppController.h"
+#include "AssetLibrary.h"
+
+#include <algorithm>
+#include <QCollator>
+#include <QDateTime>
+#include <QDir>
+#include <QFile>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QNetworkAccessManager>
+#include <QNetworkReply>
+#include <QNetworkRequest>
+#include <QRegularExpression>
+#include <QSettings>
+#include <QStandardPaths>
+#include <QTimer>
+#include <QUrl>
+#include <QUrlQuery>
+#include <QVector>
+#include <QtMath>
+
+namespace {
+
+constexpr double kMinScene = 2.0;
+constexpr double kTargetScene = 3.2;
+constexpr double kPreferredMax = 4.0;
+constexpr double kHardMax = 5.0;
+
+double durationOf(double start, double end)
+{
+    return qMax(0.0, end - start);
+}
+
+QString collapseSpaces(QString value)
+{
+    value.replace(QRegularExpression(QStringLiteral("\\s+")), QStringLiteral(" "));
+    return value.trimmed();
+}
+
+} // namespace
+
+FishAudioController::FishAudioController(AssetLibrary *assets, AppController *editor, QObject *parent)
+    : QObject(parent)
+    , m_assets(assets)
+    , m_editor(editor)
+    , m_network(new QNetworkAccessManager(this))
+{
+    QSettings settings;
+    m_apiKey = settings.value(QStringLiteral("egipto/fishApiKey")).toString();
+    m_referenceId = settings.value(QStringLiteral("egipto/fishReferenceId")).toString();
+    m_modelId = settings.value(QStringLiteral("egipto/fishModelId"), QStringLiteral("s2-pro")).toString();
+    m_speed = settings.value(QStringLiteral("egipto/fishSpeed"), 1.0).toDouble();
+    m_autoPlaceMedia = settings.value(QStringLiteral("egipto/fishAutoPlace"), true).toBool();
+
+    if (m_assets) {
+        connect(m_assets, &AssetLibrary::countChanged, this, [this] {
+            scheduleAutoPlacement();
+        });
+        connect(m_assets, &AssetLibrary::assetMetadataChanged, this, [this](const QString &assetId) {
+            if (assetId == m_pendingVoiceAssetId)
+                tryPlacePendingVoice();
+            scheduleAutoPlacement();
+        });
+        connect(m_assets, &AssetLibrary::importFinished, this, [this](int, int) {
+            scheduleAutoPlacement();
+        });
+    }
+}
+
+FishAudioController::~FishAudioController()
+{
+    resetNetworkState();
+}
+
+void FishAudioController::setApiKey(const QString &value)
+{
+    if (m_apiKey == value)
+        return;
+    m_apiKey = value;
+    saveSettings();
+    emit apiKeyChanged();
+}
+
+void FishAudioController::setReferenceId(const QString &value)
+{
+    if (m_referenceId == value)
+        return;
+    m_referenceId = value;
+    saveSettings();
+    emit referenceIdChanged();
+}
+
+void FishAudioController::setModelId(const QString &value)
+{
+    const QString cleaned = value.trimmed().isEmpty() ? QStringLiteral("s2-pro") : value.trimmed();
+    if (m_modelId == cleaned)
+        return;
+    m_modelId = cleaned;
+    saveSettings();
+    emit modelIdChanged();
+}
+
+void FishAudioController::setSpeed(double value)
+{
+    value = qBound(0.5, value, 1.8);
+    if (qFuzzyCompare(m_speed, value))
+        return;
+    m_speed = value;
+    saveSettings();
+    emit speedChanged();
+}
+
+void FishAudioController::setAutoPlaceMedia(bool value)
+{
+    if (m_autoPlaceMedia == value)
+        return;
+    m_autoPlaceMedia = value;
+    saveSettings();
+    emit autoPlaceMediaChanged();
+    if (value)
+        scheduleAutoPlacement();
+}
+
+void FishAudioController::setBusy(bool value)
+{
+    if (m_busy == value)
+        return;
+    m_busy = value;
+    emit busyChanged();
+}
+
+void FishAudioController::setStatus(const QString &value)
+{
+    if (m_status == value)
+        return;
+    m_status = value;
+    emit statusChanged();
+}
+
+void FishAudioController::clearError()
+{
+    if (m_errorString.isEmpty())
+        return;
+    m_errorString.clear();
+    emit errorStringChanged();
+}
+
+void FishAudioController::fail(const QString &message)
+{
+    setBusy(false);
+    setStatus(tr("Error"));
+    m_errorString = message;
+    emit errorStringChanged();
+    resetNetworkState();
+}
+
+void FishAudioController::saveSettings()
+{
+    QSettings settings;
+    settings.setValue(QStringLiteral("egipto/fishApiKey"), m_apiKey);
+    settings.setValue(QStringLiteral("egipto/fishReferenceId"), m_referenceId);
+    settings.setValue(QStringLiteral("egipto/fishModelId"), m_modelId);
+    settings.setValue(QStringLiteral("egipto/fishSpeed"), m_speed);
+    settings.setValue(QStringLiteral("egipto/fishAutoPlace"), m_autoPlaceMedia);
+}
+
+void FishAudioController::loadVoices()
+{
+    clearError();
+    if (m_apiKey.trimmed().isEmpty()) {
+        fail(tr("Añade primero tu API Key de Fish Audio."));
+        return;
+    }
+
+    QUrl url(QStringLiteral("https://api.fish.audio/model"));
+    QUrlQuery query;
+    query.addQueryItem(QStringLiteral("self"), QStringLiteral("true"));
+    query.addQueryItem(QStringLiteral("page_size"), QStringLiteral("50"));
+    query.addQueryItem(QStringLiteral("page_number"), QStringLiteral("1"));
+    query.addQueryItem(QStringLiteral("sort_by"), QStringLiteral("created_at"));
+    url.setQuery(query);
+
+    QNetworkRequest request(url);
+    request.setRawHeader("Authorization", QByteArray("Bearer ") + m_apiKey.toUtf8());
+
+    setBusy(true);
+    setStatus(tr("Cargando voces Fish…"));
+
+    QNetworkReply *reply = m_network->get(request);
+    connect(reply, &QNetworkReply::finished, this, [this, reply] {
+        const QByteArray body = reply->readAll();
+        const auto error = reply->error();
+        const QString networkMessage = reply->errorString();
+        reply->deleteLater();
+
+        if (error != QNetworkReply::NoError) {
+            fail(tr("Fish Audio no pudo cargar las voces: %1").arg(networkMessage));
+            return;
+        }
+
+        const QJsonDocument document = QJsonDocument::fromJson(body);
+        if (!document.isObject()) {
+            fail(tr("Fish Audio devolvió una respuesta de voces no válida."));
+            return;
+        }
+
+        QVariantList list;
+        const QJsonArray items = document.object().value(QStringLiteral("items")).toArray();
+        for (const QJsonValue &entry : items) {
+            const QJsonObject object = entry.toObject();
+            const QString id = object.value(QStringLiteral("_id")).toString(
+                object.value(QStringLiteral("id")).toString());
+            if (id.isEmpty())
+                continue;
+
+            QVariantMap voice;
+            voice.insert(QStringLiteral("id"), id);
+            voice.insert(QStringLiteral("title"),
+                         object.value(QStringLiteral("title")).toString(tr("Voz sin nombre")));
+            voice.insert(QStringLiteral("state"), object.value(QStringLiteral("state")).toString());
+            list.append(voice);
+        }
+
+        m_voices = list;
+        emit voicesChanged();
+        setBusy(false);
+        setStatus(tr("%1 voces cargadas.").arg(list.size()));
+    });
+}
+
+void FishAudioController::generateVoiceAndTimeline(const QString &script)
+{
+    clearError();
+    if (m_busy) {
+        fail(tr("Ya hay una operación Fish Audio en curso."));
+        return;
+    }
+    if (m_apiKey.trimmed().isEmpty()) {
+        fail(tr("Falta la API Key de Fish Audio."));
+        return;
+    }
+    if (m_referenceId.trimmed().isEmpty()) {
+        fail(tr("Selecciona una voz Fish o pega su Reference ID."));
+        return;
+    }
+    if (collapseSpaces(script).isEmpty()) {
+        fail(tr("Pega primero el guion original."));
+        return;
+    }
+
+    m_script = script;
+    m_blocks.clear();
+    m_segments.clear();
+    m_segmentsByChunk.clear();
+    m_audioBytes.clear();
+    m_sseBuffer.clear();
+    m_nextMediaSlot = 0;
+    m_placedVisualAssetIds.clear();
+    emit blocksChanged();
+    emit nextMediaSlotChanged();
+
+    startVoiceRequest(script);
+}
+
+void FishAudioController::startVoiceRequest(const QString &script)
+{
+    QJsonObject prosody;
+    prosody.insert(QStringLiteral("speed"), m_speed);
+    prosody.insert(QStringLiteral("volume"), 0);
+    prosody.insert(QStringLiteral("normalize_loudness"), true);
+
+    QJsonObject payload;
+    payload.insert(QStringLiteral("text"), script);
+    payload.insert(QStringLiteral("reference_id"), m_referenceId);
+    payload.insert(QStringLiteral("prosody"), prosody);
+    payload.insert(QStringLiteral("temperature"), 0.7);
+    payload.insert(QStringLiteral("top_p"), 0.7);
+    payload.insert(QStringLiteral("chunk_length"), 300);
+    payload.insert(QStringLiteral("normalize"), true);
+    payload.insert(QStringLiteral("format"), QStringLiteral("mp3"));
+    payload.insert(QStringLiteral("sample_rate"), 44100);
+    payload.insert(QStringLiteral("mp3_bitrate"), 128);
+    payload.insert(QStringLiteral("latency"), QStringLiteral("normal"));
+    payload.insert(QStringLiteral("max_new_tokens"), 1024);
+    payload.insert(QStringLiteral("repetition_penalty"), 1.2);
+    payload.insert(QStringLiteral("min_chunk_length"), 50);
+    payload.insert(QStringLiteral("condition_on_previous_chunks"), true);
+    payload.insert(QStringLiteral("early_stop_threshold"), 1);
+
+    QNetworkRequest request(QUrl(QStringLiteral("https://api.fish.audio/v1/tts/stream/with-timestamp")));
+    request.setHeader(QNetworkRequest::ContentTypeHeader, QStringLiteral("application/json"));
+    request.setRawHeader("Authorization", QByteArray("Bearer ") + m_apiKey.toUtf8());
+    request.setRawHeader("Accept", "text/event-stream");
+    request.setRawHeader("model", m_modelId.toUtf8());
+
+    resetNetworkState();
+    setBusy(true);
+    setStatus(tr("Generando voz + timestamps reales…"));
+
+    m_reply = m_network->post(request, QJsonDocument(payload).toJson(QJsonDocument::Compact));
+
+    connect(m_reply, &QIODevice::readyRead, this, [this] {
+        if (!m_reply)
+            return;
+        m_sseBuffer += m_reply->readAll();
+        consumeSse();
+    });
+
+    connect(m_reply, &QNetworkReply::finished, this, [this] {
+        if (!m_reply)
+            return;
+
+        m_sseBuffer += m_reply->readAll();
+        consumeSse();
+
+        if (m_reply->error() != QNetworkReply::NoError) {
+            const QString message = m_reply->errorString();
+            m_reply->deleteLater();
+            m_reply = nullptr;
+            fail(tr("Fish Audio falló al generar la voz: %1").arg(message));
+            return;
+        }
+
+        m_reply->deleteLater();
+        m_reply = nullptr;
+        finishVoiceRequest();
+    });
+}
